{
  "name": "esi-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run sitemap && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshot": "node scripts/screenshot.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "sitemap": "node scripts/sitemap.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "description": "Engineering System Integration Co., Ltd. (ESI) corporate website - frontend-only static site"
}
